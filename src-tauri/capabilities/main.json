{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "主窗口：只能调用小药箱自己的命令，不开放文件、Shell、网络等任何插件能力。",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-system-info",
    "allow-catalog-summary",
    "allow-symptom-detail",
    "allow-run-profile",
    "allow-run-check",
    "allow-feature-detect",
    "allow-feature-preview",
    "allow-feature-apply",
    "allow-journal-list",
    "allow-journal-undo",
    "allow-journal-undo-session",
    "allow-report-generate",
    "allow-tool-run",
    "allow-tool-open",
    "allow-startup-list",
    "allow-startup-set",
    "allow-context-menu-list",
    "allow-context-menu-set",
    "allow-new-menu-list",
    "allow-new-menu-set",
    "allow-shell-places-list",
    "allow-shell-places-set",
    "allow-rename-select-folder",
    "allow-rename-preview",
    "allow-rename-apply",
    "allow-rename-undo",
    "allow-image-select-folder",
    "allow-image-save",
    "allow-image-open-folder",
    "allow-pdf-save",
    "allow-pdf-reveal",
    "allow-long-image-save",
    "allow-long-image-reveal",
    "allow-hidden-pick-folder",
    "allow-hidden-rescan",
    "allow-hidden-restore",
    "allow-hidden-undo",
    "allow-disk-speed-drives",
    "allow-disk-speed-run",
    "allow-screen-fullscreen",
    "allow-awake-get",
    "allow-awake-set",
    "allow-shutdown-get",
    "allow-shutdown-schedule",
    "allow-shutdown-cancel",
    "allow-lockers-pick-files",
    "allow-lockers-pick-folder",
    "allow-lockers-refresh",
    "allow-space-pick-folder",
    "allow-space-rescan",
    "allow-space-reveal"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Symptom",
  "description": "症状诊断树。",
  "type": "object",
  "properties": {
    "category": {
      "description": "归哪一类：network、system、software、files、printer、display、desktop、input、hardware",
      "$ref": "#/$defs/SymptomCategory"
    },
    "causes": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Text"
      }
    },
    "guide": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "links": {
      "description": "手动步骤下面的按钮：`tool:<id>`、`symptom:<id>`，或者 `test:<设备测试>`（工具箱里的喇叭、麦克风、键盘这些测试，\n修完以后试一试），给指引里提到的小工具、相关症状",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "maturity": {
      "$ref": "#/$defs/Maturity"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "steps": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Step"
      }
    },
    "summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "title": {
      "$ref": "#/$defs/Text"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "title",
    "category",
    "maturity"
  ],
  "$defs": {
    "Maturity": {
      "type": "string",
      "enum": [
        "guide",
        "semi",
        "one-click"
      ]
    },
    "Status": {
      "description": "检测结论。",
      "oneOf": [
        {
          "description": "正常",
          "type": "string",
          "const": "ok"
        },
        {
          "description": "建议处理",
          "type": "string",
          "const": "advice"
        },
        {
          "description": "需要人工",
          "type": "string",
          "const": "manual"
        },
        {
          "description": "没查出来",
          "type": "string",
          "const": "unknown"
        },
        {
          "description": "不适用（不显示）",
          "type": "string",
          "const": "na"
        }
      ]
    },
    "Step": {
      "type": "object",
      "properties": {
        "check": {
          "type": "string"
        },
        "fixes": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "stop_on": {
          "description": "这一步的结论在列表里时，不再往下查",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Status"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "check"
      ]
    },
    "SymptomCategory": {
      "description": "症状归哪一类（功能清单 docs/features.md 按它分组）。",
      "oneOf": [
        {
          "description": "上网和共享",
          "type": "string",
          "const": "network"
        },
        {
          "description": "开机和系统",
          "type": "string",
          "const": "system"
        },
        {
          "description": "软件和浏览器",
          "type": "string",
          "const": "software"
        },
        {
          "description": "文件和 C 盘",
          "type": "string",
          "const": "files"
        },
        {
          "description": "打印机",
          "type": "string",
          "const": "printer"
        },
        {
          "description": "屏幕和显卡",
          "type": "string",
          "const": "display"
        },
        {
          "description": "桌面、任务栏和开始菜单",
          "type": "string",
          "const": "desktop"
        },
        {
          "description": "键盘、鼠标和输入法",
          "type": "string",
          "const": "input"
        },
        {
          "description": "声音、蓝牙、U 盘和其他设备",
          "type": "string",
          "const": "hardware"
        }
      ]
    },
    "Text": {
      "description": "本地化文本：语言标签到文本的映射，必须包含 `zh-CN`。",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}

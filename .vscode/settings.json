{
  "yaml.schemas": {
    "./schema/check.schema.json": "catalog/checks/**/*.yaml",
    "./schema/feature.schema.json": "catalog/features/**/*.yaml",
    "./schema/symptom.schema.json": "catalog/symptoms/**/*.yaml",

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.rs]
indent_size = 4

[*.ps1]
# 脚本只允许 ASCII 字符（见 docs/architecture.md 5.1），Windows 下用 CRLF 更友好
end_of_line = crlf
indent_size = 4

[*.md]
trim_trailing_whitespace = false
